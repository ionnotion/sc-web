# --- dev server ---
# Where `npm run dev` proxies /api to (the Go backend)
DEV_API_URL=http://localhost:8080

# --- site info shown on the public pages (baked in at build time) ---
VITE_SITE_NAME=Your School Name
VITE_SITE_TAGLINE=Learning, character and community.
VITE_SITE_ADDRESS=Jl. Contoh No. 1, City, Province
VITE_SITE_PHONE=+62 000 0000 0000
VITE_SITE_EMAIL=info@yourschool.sch.id

# Only if the API lives on another origin (then also set CORS_ORIGINS on the backend).
# Leave empty to call the same origin at /api (recommended).
VITE_API_BASE=
